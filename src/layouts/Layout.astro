---
import Head from '@/components/Head.astro'
import Navbar from '@/components/Navbar.astro'
import { SITE } from '@/consts'
import { cn } from '@/lib/utils'
import '@/styles/global.css'
import '@/styles/typography.css'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<!doctype html>
<html
  class="bg-background text-foreground scheme-light-dark"
  lang={SITE.locale}
>
  <Head>
    <slot name="head" />
  </Head>
  <body class="flex min-h-screen flex-col font-sans antialiased">
    <!-- Fading top background -->
    <div class="absolute inset-0 top-0 left-0 right-0 h-[300px] overflow-hidden z-0 pointer-events-none">
      <div class="h-full w-full bg-linear-to-b from-primary/5 to-transparent"></div>
    </div>

    <!-- <header class="sticky top-0 z-50 w-full">
      <slot name="subposts-navigation" />
      <slot name="table-of-contents" />
    </header> -->

    <main
      class={cn('w-full mx-auto flex grow flex-col px-4 mb-24 max-w-2xl', className)}
    >
      <!-- <ScrollTop /> -->
      <slot />
    </main>

    <Navbar />
    <!-- <Footer /> -->
  </body>
</html>

