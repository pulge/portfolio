---
import AvatarComponent from '@/components/ui/avatar'
import {
  getCombinedReadingTime,
  getSubpostCount,
  isSubpost,
  parseAuthors,
} from '@/lib/data-utils'
import { cn, formatDate, slugify } from '@/lib/utils'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import Link from './Link.astro'

interface Props {
  entry: CollectionEntry<'blog'>
  variant?: 'list' | 'grid'
}

const { entry, variant = 'list' } = Astro.props
const formattedDate = formatDate(entry.data.date)
const readTime = await getCombinedReadingTime(entry.id)
const authors = await parseAuthors(entry.data.authors ?? [])
const subpostCount = !isSubpost(entry.id) ? await getSubpostCount(entry.id) : 0
---

<div
  class={cn(
    'group relative flex flex-col overflow-hidden transition-all duration-300',
    'rounded-[12px] border-[0.5px] border-border shadow-none bg-white/25',
    'hover:border-foreground/20 hover:-translate-y-[2px]',
  )}
>
  <Link
    href={`/${entry.collection}/${entry.id}`}
    class={cn(
      "flex h-full flex-col",
      variant === 'list' && "sm:flex-row"
    )}
  >
    {
      entry.data.image && (
        <div class={cn(
          "border-border relative aspect-video w-full shrink-0 overflow-hidden border-b-[0.5px]",
          variant === 'list' && "sm:aspect-square sm:w-48 sm:border-r-[0.5px] sm:border-b-0"
        )}>
          <Image
            src={entry.data.image}
            alt={entry.data.title}
            width={400}
            height={400}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </div>
      )
    }

    <div class="flex flex-1 flex-col gap-y-3 p-4">
      <div class="flex flex-col gap-y-1">
        <div class="flex items-center justify-between gap-2">
          <h3
            class="text-foreground text-[14px] leading-none font-medium tracking-tight"
          >
            {entry.data.title}
          </h3>
          <time
            class="text-muted-foreground font-sans text-[10px] whitespace-nowrap"
            >{formattedDate}</time
          >
        </div>
        <p
          class="text-muted-foreground line-clamp-2 text-[12px] leading-relaxed"
        >
          {entry.data.description}
        </p>
      </div>

      <div class="mt-auto flex items-center gap-x-2">
        {
          authors.map((author) => (
            <div class="flex items-center gap-x-1.5">
              <AvatarComponent
                client:load
                src={author.avatar}
                alt={author.name}
                fallback={author.name[0]}
                className="size-4 rounded-full border-[0.5px] border-border"
              />
              <span class="text-muted-foreground text-[10px]">
                {author.name}
              </span>
            </div>
          ))
        }
        <span class="text-muted-foreground/50 text-[10px]">•</span>
        <span class="text-muted-foreground text-[10px]">{readTime}</span>
      </div>

      {
        entry.data.tags && (
          <div class="flex flex-wrap gap-1.5 pt-1">
            {entry.data.tags.map((tag) => (
              <span class="bg-secondary/30 border-border text-muted-foreground/80 hover:bg-secondary/60 hover:text-foreground inline-flex items-center rounded-full border-[0.5px] px-2 py-0.5 text-[11px] font-normal transition-colors">
                {slugify(tag)}
              </span>
            ))}
          </div>
        )
      }
    </div>
  </Link>
</div>
