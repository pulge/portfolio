---
import { Card } from '@/components/ui/card'
import { cn, slugify } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'

interface Props {
  title: string
  description: string
  tags: string[]
  image?: any
  link?: string
  className?: string
}

const { title, description, tags, image, link, className } = Astro.props
---

<Card className={cn(
  "group relative flex flex-col h-full overflow-hidden transition-all duration-300",
  "rounded-[12px] border-[0.5px] border-border shadow-none bg-white/25 py-0",
  "hover:border-foreground/20 hover:-translate-y-[2px]",
  className
)}>
  <div class="relative aspect-video shrink-0 overflow-hidden border-b-[0.5px]">
    {image ? (
      <Image 
        src={image} 
        alt={title} 
        class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-105"
      />
    ) : (
      <div class="size-full flex items-center justify-center bg-muted/10 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]">
        <div class="px-2 py-1 rounded-full border-[0.5px] border-border bg-background/80 backdrop-blur-sm">
          <span class="text-[9px] font-mono text-muted-foreground/80 uppercase tracking-widest">no preview</span>
        </div>
      </div>
    )}
    
    {link && (
       <a 
        href={link} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="absolute top-2 right-2 p-1.5 rounded-full bg-background/80 backdrop-blur-sm border-[0.5px] border-border opacity-0 group-hover:opacity-100 transition-opacity hover:bg-background"
        aria-label={`Open ${title}`}
      >
        <Icon name="lucide:arrow-up-right" class="size-3 text-muted-foreground" />
      </a>
    )}
  </div>

  <div class="flex flex-col flex-1 p-4">
    <div class="flex flex-col gap-y-1 mb-3">
      <h3 class="text-[14px] font-medium leading-none tracking-tight text-foreground">{title}</h3>
      <p class="text-[12px] text-muted-foreground line-clamp-2 leading-relaxed">
        {description}
      </p>
    </div>

    <div class="flex flex-wrap gap-1.5 mt-auto">
      {tags?.map((tag, index) => (
        <span class={cn(
          "inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-normal transition-colors",
          "bg-secondary/30 border-[0.5px] border-border text-muted-foreground/80",
          "hover:bg-secondary/60 hover:text-foreground",
          index === 0 && "border-foreground/20 text-foreground/90 bg-secondary/40"
        )}>
          {slugify(tag)}
        </span>
      ))}
    </div>
  </div>
</Card>
