---
import BlurFade from '@/components/magicui/BlurFade'
import type { ImageMetadata } from 'astro'
import { Icon } from 'astro-icon/components'
import { Image, getImage } from 'astro:assets'
import { getFullSizeImages } from '../lib/media-utils'

interface Props {
  name: string
  id: string
  images: ImageMetadata[]
  delay?: number
}

const { name, images, id, delay = 0 } = Astro.props

console.log(
  `[PhotoGallery] Rendering gallery for ${name} with ${images.length} images`,
)

// Create a map of full-size image URLs and metadata
const fullSizeImages = await getFullSizeImages(images, id)

// Generate optimized full-size URLs for each image
const optimizedImages = await Promise.all(
  images.map(async (img) => {
    try {
      const optimized = await getImage({
        src: img, // Pass the entire image object
        format: 'webp',
        quality: 90,
      })
      console.log(`[PhotoGallery] Optimized image -> ${optimized.src}`)
      return optimized.src
    } catch (error) {
      console.error(`[PhotoGallery] Error optimizing image:`, error)
      // Fallback to the original image object
      return typeof img === 'string' ? img : img.src
    }
  }),
)

console.log(
  `[PhotoGallery] Full-size images processed: ${fullSizeImages.length}`,
)
---

<div>
  <BlurFade delay={delay} client:load>
    <div class="columns-1 gap-5 sm:columns-2 sm:gap-2 md:columns-3">
      {
        images.map((image, index) => {
          const fullImage = fullSizeImages[index]
          const optimizedSrc = optimizedImages[index]
          console.log(`[PhotoGallery] Rendering image ${index}`)

          return (
            <div class="relative mb-5 break-inside-avoid sm:mb-2">
              <Image
                src={image}
                alt={`Photo ${index + 1} from ${name}`}
                loading={index < 15 ? 'eager' : 'lazy'}
                decoding={index < 15 ? 'sync' : 'async'}
                class="gallery-item gallery-image cursor-pointer transition-opacity hover:opacity-90"
                draggable={false}
                data-index={index}
                data-fullsize={optimizedSrc}
                data-fullwidth={fullImage.width}
                data-fullheight={fullImage.height}
                data-placeholder={fullImage.blurDataUrl}
                data-hash={fullImage.hash}
                widths={[360, 720, 1200]}
                sizes={`(max-width: 360px) 360px, (max-width: 720px) 720px, 1200px`}
              />
            </div>
          )
        })
      }
    </div>
  </BlurFade>

  <!-- Overlay container -->
  <div
    id="gallery-overlay"
    class="bg-background/50 fixed inset-0 z-[9999] hidden h-screen w-screen backdrop-blur-lg"
  >
    <div
      class="relative flex h-full w-full items-center justify-center overflow-hidden"
      id="overlay-container"
    >
      <!-- Left navigation arrow -->
      <button
        id="prev-button"
        class="text-primary hover:bg-secondary/50 absolute left-5 z-50 hidden cursor-pointer p-1.5 opacity-70 transition-all duration-300 hover:opacity-100 xl:block"
        aria-label="Previous image"
      >
        <Icon name="lucide:chevron-left" class="size-7" />
      </button>

      <div
        id="image-stack"
        class="relative grid h-full w-full place-items-center"
      >
        <div
          id="image-container-placeholder"
          class="image-container z-[1] col-start-1 row-start-1 h-full w-full"
        >
          {
            fullSizeImages.map((image, index) => (
              <img
                id={image.hash}
                src={image.blurDataUrl}
                alt={`Placeholder for photo ${index + 1} from ${name}`}
                class="gallery-placeholder hidden"
                width={image.width}
                height={image.height}
                style={{
                  maxWidth: '90vw',
                  maxHeight: '90vh',
                  width: 'auto',
                  height: 'auto',
                }}
                decoding="sync"
                loading="eager"
              />
            ))
          }
        </div>

        <div
          id="image-container"
          class="image-container z-[2] col-start-1 row-start-1 h-full w-full"
        >
        </div>
      </div>

      <!-- Right navigation arrow -->
      <button
        id="next-button"
        class="text-primary hover:bg-secondary/50 absolute right-5 z-50 hidden cursor-pointer p-1.5 opacity-70 transition-all duration-300 hover:opacity-100 xl:block"
        aria-label="Next image"
      >
        <Icon name="lucide:chevron-right" class="size-7" />
      </button>

      <!-- Close button -->
      <button
        id="close-button"
        class="text-primary hover:bg-secondary/50 absolute top-3 right-3 z-50 cursor-pointer p-1.5 opacity-70 transition-all duration-300 hover:opacity-100 sm:top-5 sm:right-5"
        aria-label="Close gallery"
        title="close"
      >
        <Icon name="lucide:x" class="size-6" />
      </button>
    </div>
  </div>
</div>

<style>
  .gallery-image {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .gallery-image-zoom {
    max-width: 90vw;
    max-height: 90vh;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: opacity 0.3s ease;
  }

  .gallery-placeholder {
    filter: blur(20px);
    transform: scale(1.1);
    max-width: 90vw;
    max-height: 90vh;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .gallery-placeholder-loaded {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  #image-container,
  #image-container-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  #image-stack {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }

  :global(body.gallery-open .navbar-container) {
    opacity: 0;
    pointer-events: none;
    transform: translateY(20px);
    transition: all 0.3s ease;
  }
</style>

<script>
  // Setup the gallery functionality
  function setupGallery() {
    console.log('[Gallery Script] Initializing gallery...')

    const isMobile = window.innerWidth < 640
    const overlay = document.getElementById('gallery-overlay') as HTMLDivElement
    const prevButton = document.getElementById(
      'prev-button',
    ) as HTMLButtonElement
    const nextButton = document.getElementById(
      'next-button',
    ) as HTMLButtonElement
    const closeButton = document.getElementById(
      'close-button',
    ) as HTMLButtonElement

    let activeImage: HTMLImageElement | null = null
    let currentIndex = -1
    let inactivityTimer: number | null = null

    // Button visibility functions
    function showButtons() {
      prevButton.style.opacity = '0.7'
      nextButton.style.opacity = '0.7'
      closeButton.style.opacity = '0.7'

      if (inactivityTimer) {
        clearTimeout(inactivityTimer)
      }

      if (!isMobile) {
        inactivityTimer = window.setTimeout(hideButtons, 2000)
      }
    }

    function hideButtons() {
      if (isMobile) return
      prevButton.style.opacity = '0'
      nextButton.style.opacity = '0'
      closeButton.style.opacity = '0'
    }

    function handleImageClick(
      event: MouseEvent | { target: HTMLImageElement },
    ) {
      const target = event.target as Element
      const previewImg = target.closest('.gallery-item') as HTMLImageElement
      if (!previewImg) return

      console.log('[Gallery Script] Image clicked:', previewImg.dataset.index)

      if (
        !overlay.classList.contains('hidden') &&
        !(
          'target' in event &&
          event.target instanceof HTMLImageElement &&
          event.target.id.startsWith('full-')
        )
      ) {
        if (
          target.closest('#prev-button') ||
          target.closest('#next-button') ||
          target.closest('#close-button')
        ) {
          if ('stopPropagation' in event) event.stopPropagation()
          return
        }

        handleCloseZoom()
        return
      }

      const imageContainer = document.getElementById(
        'image-container',
      ) as HTMLDivElement

      const fullSizeSrc = previewImg.dataset.fullsize || ''
      const imageHash = previewImg.dataset.hash || ''

      // Create full-size image
      const fullSizeImg = document.createElement('img')
      fullSizeImg.id = `full-${imageHash}`
      fullSizeImg.className = 'gallery-image-zoom'
      fullSizeImg.src = fullSizeSrc
      fullSizeImg.alt = previewImg.alt
      fullSizeImg.draggable = false
      fullSizeImg.style.maxWidth = '90vw'
      fullSizeImg.style.maxHeight = '90vh'
      fullSizeImg.style.width = 'auto'
      fullSizeImg.style.height = 'auto'
      fullSizeImg.style.objectFit = 'contain'
      fullSizeImg.style.zIndex = '2'
      fullSizeImg.style.opacity = '0'

      activeImage = fullSizeImg
      currentIndex = parseInt(previewImg.dataset.index || '0', 10)

      imageContainer.appendChild(fullSizeImg)

      // Show overlay
      overlay.classList.remove('hidden')
      document.body.style.overflow = 'hidden'
      document.body.classList.add('gallery-open')
      showButtons()
      overlay.addEventListener('mousemove', showButtons)

      const placeholderImg = document.getElementById(
        imageHash,
      ) as HTMLImageElement
      if (placeholderImg) {
        placeholderImg.classList.remove('hidden')
      }

      if (fullSizeImg.complete) {
        fullSizeImg.style.opacity = '1'
        if (placeholderImg) {
          setTimeout(
            () => placeholderImg.classList.add('gallery-placeholder-loaded'),
            100,
          )
        }
      } else {
        fullSizeImg.onload = () => {
          fullSizeImg.style.opacity = '1'
          if (placeholderImg) {
            setTimeout(
              () => placeholderImg.classList.add('gallery-placeholder-loaded'),
              300,
            )
          }
        }
      }
    }

    function handleCloseZoom() {
      if (!activeImage) return
      const currentHash = activeImage.id.replace('full-', '')
      const currentPlaceholder = document.getElementById(currentHash)
      if (currentPlaceholder) {
        currentPlaceholder.classList.remove('gallery-placeholder-loaded')
        currentPlaceholder.classList.add('hidden')
      }
      activeImage.remove()
      overlay.classList.add('hidden')
      document.body.style.overflow = ''
      document.body.classList.remove('gallery-open')
      if (inactivityTimer) clearTimeout(inactivityTimer)
      overlay.removeEventListener('mousemove', showButtons)
      activeImage = null
      currentIndex = -1
    }

    function navigateGallery(direction: number) {
      if (currentIndex === -1) return

      const galleryImages = document.querySelectorAll(
        '.gallery-item',
      ) as NodeListOf<HTMLImageElement>
      const imagesArray = Array.from(galleryImages)
      const totalImages = imagesArray.length
      if (totalImages === 0) return

      const newIndex = (currentIndex + direction + totalImages) % totalImages
      const targetImg = imagesArray[newIndex]

      handleCloseZoom()
      handleImageClick({ target: targetImg })
    }

    // Use event delegation for gallery images
    document.addEventListener('click', (e) => {
      const target = e.target as Element
      if (target.closest('.gallery-item')) {
        handleImageClick(e as MouseEvent)
      }
    })

    // Navigation event listeners
    prevButton.addEventListener('click', (e) => {
      e.stopPropagation()
      navigateGallery(-1)
    })

    nextButton.addEventListener('click', (e) => {
      e.stopPropagation()
      navigateGallery(1)
    })

    closeButton.addEventListener('click', (e) => {
      e.stopPropagation()
      handleCloseZoom()
    })

    overlay.addEventListener('click', (e) => {
      const target = e.target as Element
      if (
        target === overlay ||
        target === document.getElementById('overlay-container')
      ) {
        handleCloseZoom()
      }
    })

    console.log('[Gallery Script] Gallery setup complete')
  }

  // Run setup when the DOM is ready
  document.addEventListener('DOMContentLoaded', setupGallery)

  // Also handle astro:page-load for Astro's view transitions
  document.addEventListener('astro:page-load', setupGallery)
</script>
