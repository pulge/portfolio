---
import { getPhotoCount } from '@/lib/media-utils'
import { cn, formatDate, slugify } from '@/lib/utils'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import Link from './Link.astro'

type Props = {
  collection: CollectionEntry<'media'>
}

const { collection } = Astro.props as {
  collection: CollectionEntry<'media'>
}

const formattedDate = collection.data.date
  ? formatDate(collection.data.date)
  : ''
const displayDate = collection.data.period

// Get photo count using the utility function
const photoCount = await getPhotoCount(collection.id)
---

<div class={cn(
  "group relative flex flex-col overflow-hidden transition-all duration-300",
  "rounded-[12px] border-[0.5px] border-border shadow-none bg-white/25",
  "hover:border-foreground/20 hover:-translate-y-[2px]"
)}>
  <Link
    href={`/${collection.collection}/${collection.id}`}
    class="flex flex-col h-full"
  >
    {collection.data.image && (
      <div class="relative aspect-video overflow-hidden border-b-[0.5px] border-border">
        <Image
          src={collection.data.image}
          alt={collection.data.name}
          width={600}
          height={338}
          class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-105"
          quality="medium"
        />
      </div>
    )}

    <div class="flex flex-col flex-1 p-4 gap-y-3">
      <div class="flex flex-col gap-y-1">
        <div class="flex items-center justify-between gap-2">
          <h3 class="text-[14px] font-medium leading-none tracking-tight text-foreground">{collection.data.name}</h3>
          <span class="text-[10px] text-muted-foreground font-sans whitespace-nowrap">{photoCount} photos</span>
        </div>
        <p class="text-[12px] text-muted-foreground line-clamp-2 leading-relaxed">
          {collection.data.description}
        </p>
      </div>

      <div class="flex items-center justify-between mt-auto">
        <span class="text-[10px] text-muted-foreground">{displayDate}</span>
        {collection.data.tags && (
          <div class="flex flex-wrap gap-1.5">
            {collection.data.tags.slice(0, 2).map((tag: string) => (
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-normal transition-colors bg-secondary/30 border-[0.5px] border-border text-muted-foreground/80">
                {slugify(tag)}
              </span>
            ))}
          </div>
        )}
      </div>
    </div>
  </Link>
</div>
