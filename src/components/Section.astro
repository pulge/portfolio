---
import { cn } from '@/lib/utils'

interface Props {
  id?: string
  title?: string
  className?: string
}

const { id, title, className } = Astro.props
---

<section id={id} class={cn('flex flex-col gap-y-4', className)}>
  {title && <h2 class="text-xl font-bold">{title}</h2>}
  <slot />
</section>
