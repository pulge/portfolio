---
import BlurFade from '@/components/magicui/BlurFade'
import PageHead from '@/components/PageHead.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import Section from '@/components/Section.astro'
import { badgeVariants } from '@/components/ui/badge'
import { SOCIAL_LINKS } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getAllCoding } from '@/lib/data-utils'
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'

const projects = await getAllCoding()

const workExperience = [
  {
    company: 'Eurolink Network International Corporation',
    role: 'Software Development Intern',
    period: 'Feb 2026 - May 2026',
    logo: null,
    points: [
      'Designed and shipped modular TSX/React components and Excel pipelines for an active MIS system.',
      'Participated in code reviews and Agile ceremonies in a professional development team.',
      'Delivered features end-to-end within two-week sprint cycles.',
    ],
  },
]

const technicalSkills = [
  { name: 'React', icon: 'logos:react' },
  { name: 'Next.js', icon: 'logos:nextjs' },
  { name: 'Vue.js', icon: 'logos:vue' },
  { name: 'Blazor', icon: 'logos:dotnet' },
  { name: 'Astro', icon: 'logos:astro' },
  { name: 'TypeScript', icon: 'logos:typescript-icon' },
  { name: 'JavaScript', icon: 'logos:javascript' },
  { name: 'Laravel', icon: 'logos:laravel' },
  { name: 'Salesforce', icon: 'logos:salesforce' },
  { name: '.NET', icon: 'logos:dotnet' },
  { name: 'PostgreSQL', icon: 'logos:postgresql' },
  { name: 'Tailwind CSS', icon: 'logos:tailwindcss-icon' },
  { name: 'Sass', icon: 'logos:sass' },
  { name: 'GitHub Actions', icon: 'logos:github-actions' },
  { name: 'Zod', icon: 'lucide:shield-check' },
]

const education = [
  {
    school: 'Polytechnic University of the Philippines',
    degree: 'BS in Information Technology (GWA 1.35)',
    period: '2022 - 2026',
    description: "Consistent President's and Dean's Lister",
    logo: null,
  },
]

const BLUR_FADE_DELAY = 0.04
---

<Layout class="max-w-2xl">
  <PageHead slot="head" />
  <div class="relative z-10 flex flex-col gap-14 py-12 pb-24 sm:py-24">
    <!-- Hero Section -->
    <Section id="hero" className="mt-[-20px]">
      <div class="flex flex-col-reverse md:flex-row items-center justify-between gap-8">
        <div class="flex flex-col gap-3 flex-1 text-center md:text-left">
          <BlurFade delay={BLUR_FADE_DELAY} client:load>
            <h1 class="text-3xl font-bold tracking-tighter sm:text-4xl lg:text-5xl">
              Hi, I'm Mark
            </h1>
          </BlurFade>
          <BlurFade delay={BLUR_FADE_DELAY * 2} client:load>
            <p class="text-muted-foreground md:text-lg lg:text-xl max-w-[600px] leading-relaxed">
              BSIT student and developer. I build production-grade web applications where architecture quality and type-safety matter.
            </p>
          </BlurFade>
        </div>
        <BlurFade delay={BLUR_FADE_DELAY} client:load>
          <div class="relative flex shrink-0 overflow-hidden size-24 md:size-32 border rounded-full shadow-lg ring-4 ring-muted">
            <Image 
              src="/static/silhouette.jpg" 
              alt="Mark" 
              width={128} 
              height={128} 
              class="aspect-square h-full w-full object-cover"
            />
          </div>
        </BlurFade>
      </div>
    </Section>

    <!-- About Section -->
    <Section id="about" title="About">
      <BlurFade delay={BLUR_FADE_DELAY * 3} client:load>
        <div class="prose max-w-full text-pretty font-sans leading-relaxed text-muted-foreground dark:prose-invert space-y-4">
          <p>
            I am a final-year BSIT student (1.35 GWA) with a passion for building scalable software. My experience ranges from shipping modular components in professional Agile teams at Eurolink to architecting complex accreditation systems for PUP San Juan.
          </p>
          <p>
            I specialize in the modern web stack—specifically Next.js, Laravel, and TypeScript—while maintaining production experience in enterprise environments like Salesforce. I focus on building resilient, type-safe tools that solve organizational challenges.
          </p>
        </div>
      </BlurFade>
    </Section>

    <!-- Education Section -->
    <Section id="education" title="Education">
      <div class="flex flex-col gap-8">
        {education.map((edu, idx) => (
          <BlurFade delay={BLUR_FADE_DELAY * (4 + idx)} client:load>
            <div class="flex items-center gap-x-3 justify-between group">
              <div class="flex items-center gap-x-3 flex-1 min-w-0">
                <div class="size-10 flex items-center justify-center border rounded-full shadow ring-2 ring-border bg-muted overflow-hidden">
                  {edu.logo ? (
                    <Image src={edu.logo} alt={edu.school} width={40} height={40} class="object-cover" />
                  ) : (
                    <Icon name="lucide:graduation-cap" class="size-5 text-muted-foreground" />
                  )}
                </div>
                <div class="flex-1 min-w-0 flex flex-col gap-0.5">
                  <div class="font-semibold leading-none flex items-center gap-2">
                    {edu.school}
                  </div>
                  <div class="font-sans text-sm text-muted-foreground line-clamp-1">
                    {edu.degree}
                  </div>
                  {edu.description && (
                    <div class="text-xs text-muted-foreground/80 mt-1 font-sans">
                      {edu.description}
                    </div>
                  )}
                </div>
              </div>
              <div class="flex items-center gap-1 text-xs tabular-nums text-muted-foreground text-right flex-none">
                <span>{edu.period}</span>
              </div>
            </div>
          </BlurFade>
        ))}
      </div>
    </Section>

    <!-- Experience Section -->
    <Section id="experience" title="Experience">
      <div class="flex flex-col gap-8">
        {workExperience.map((exp, idx) => (
          <BlurFade delay={BLUR_FADE_DELAY * (5 + idx)} client:load>
            <div class="flex flex-col gap-2">
              <div class="flex items-center gap-x-3 justify-between group">
                <div class="flex items-center gap-x-3 flex-1 min-w-0">
                  <div class="size-10 flex items-center justify-center border rounded-full shadow ring-2 ring-border bg-muted overflow-hidden">
                    {exp.logo ? (
                      <Image src={exp.logo} alt={exp.company} width={40} height={40} class="object-cover" />
                    ) : (
                      <Icon name="lucide:briefcase" class="size-5 text-muted-foreground" />
                    )}
                  </div>
                  <div class="flex-1 min-w-0 flex flex-col gap-0.5">
                    <div class="font-semibold leading-none flex items-center gap-2">
                      {exp.role}
                    </div>
                    <div class="font-sans text-sm text-muted-foreground line-clamp-1">
                      {exp.company}
                    </div>
                  </div>
                </div>
                <div class="flex items-center gap-1 text-xs tabular-nums text-muted-foreground text-right flex-none">
                  <span>{exp.period}</span>
                </div>
              </div>
              <ul class="text-sm text-muted-foreground list-disc list-inside space-y-1 ml-[3.25rem]">
                {exp.points.map(point => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          </BlurFade>
        ))}
      </div>
    </Section>

    <!-- Skills Section -->
    <Section id="skills" title="Skills">
      <div class="flex flex-wrap gap-2">
        {technicalSkills.map((skill, idx) => (
          <BlurFade delay={BLUR_FADE_DELAY * (7 + idx)} client:load>
            <div class={cn(badgeVariants({ variant: 'outline' }), "rounded-xl h-8 px-4 flex items-center gap-2 border-border ring-2 ring-border/5")}>
              {skill.icon ? (
                <Icon name={skill.icon} class="size-3.5" />
              ) : (
                <Icon name="lucide:cpu" class="size-3.5 text-muted-foreground" />
              )}
              <span class="text-foreground text-sm font-medium">{skill.name}</span>
            </div>
          </BlurFade>
        ))}
      </div>
    </Section>

    <!-- Projects Section -->
    <Section id="projects" title="Projects">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="flex flex-col gap-4">
          {projects.filter((_, idx) => idx % 2 === 0).map((project, idx) => (
            <BlurFade delay={BLUR_FADE_DELAY * (12 + idx * 2)} client:load>
              <ProjectCard 
                title={project.data.title}
                description={project.data.description}
                tags={project.data.tags}
                image={project.data.image}
                link={project.data.link}
              />
            </BlurFade>
          ))}
        </div>
        <div class="flex flex-col gap-4">
          {projects.filter((_, idx) => idx % 2 !== 0).map((project, idx) => (
            <BlurFade delay={BLUR_FADE_DELAY * (13 + idx * 2)} client:load>
              <ProjectCard 
                title={project.data.title}
                description={project.data.description}
                tags={project.data.tags}
                image={project.data.image}
                link={project.data.link}
              />
            </BlurFade>
          ))}
        </div>
      </div>
    </Section>

    <!-- Contact Section -->
    <Section id="contact" title="Get in Touch">
      <BlurFade delay={BLUR_FADE_DELAY * 15} client:load>
        <p class="text-muted-foreground">
          If you have any message, suggestions, or inquiries, don’t hesitate to drop it in my 
          <a href={SOCIAL_LINKS.find(l => l.label === 'Inbox')?.href || '#'} class="text-foreground underline underline-offset-4 decoration-border hover:decoration-foreground transition-colors">inbox</a>.
        </p>
        <div class="flex gap-4 mt-2">
          {SOCIAL_LINKS.filter(l => l.label !== 'Inbox').map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors">
              <span class="text-sm">{link.label}</span>
            </a>
          ))}
        </div>
      </BlurFade>
    </Section>
  </div>
</Layout>
