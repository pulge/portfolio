---
import BlurFade from '@/components/magicui/BlurFade'
import ProjectCard from '@/components/ProjectCard.astro'
import Section from '@/components/Section.astro'
import { badgeVariants } from '@/components/ui/badge'
import { SOCIAL_LINKS } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getAllCoding } from '@/lib/data-utils'
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'

const projects = await getAllCoding()

const skills = [
  'React',
  'Next.js',
  'Astro',
  'TypeScript',
  'JavaScript',
  'Laravel',
  'PHP',
  'Node.js',
  'Tailwind CSS',
  'Sass',
  'PostgreSQL',
  'MySQL',
  'Git',
  'GitHub',
]

const education = [
  {
    school: 'Polytechnic University of the Philippines',
    degree: 'Bachelor of Science in Information Technology',
    period: '2022 - Present',
    logo: '/static/logo.png',
  },
]

const BLUR_FADE_DELAY = 0.04
---

<Layout class="max-w-2xl">
  <div class="relative z-10 flex flex-col gap-14 py-12 pb-24 sm:py-24">
    <!-- Hero Section -->
    <Section id="hero" className="mt-[-20px]">
      <div class="flex flex-col-reverse md:flex-row items-center justify-between gap-8">
        <div class="flex flex-col gap-3 flex-1 text-center md:text-left">
          <BlurFade delay={BLUR_FADE_DELAY} client:load>
            <h1 class="text-3xl font-bold tracking-tighter sm:text-4xl lg:text-5xl">
              Hi, I'm Mark
            </h1>
          </BlurFade>
          <BlurFade delay={BLUR_FADE_DELAY * 2} client:load>
            <p class="text-muted-foreground md:text-lg lg:text-xl max-w-[600px]">
              Undergrad IT Student from PUP San Juan. I love building web applications and exploring UI/UX design.
            </p>
          </BlurFade>
        </div>
        <BlurFade delay={BLUR_FADE_DELAY} client:load>
          <div class="relative flex shrink-0 overflow-hidden size-24 md:size-32 border rounded-full shadow-lg ring-4 ring-muted">
            <Image 
              src="/static/silhouette.jpg" 
              alt="Mark" 
              width={128} 
              height={128} 
              class="aspect-square h-full w-full object-cover"
            />
          </div>
        </BlurFade>
      </div>
    </Section>

    <!-- About Section -->
    <Section id="about" title="About">
      <BlurFade delay={BLUR_FADE_DELAY * 3} client:load>
        <div class="prose max-w-full text-pretty font-sans leading-relaxed text-muted-foreground dark:prose-invert">
          <p>
            I'm currently pursuing a degree in Information Technology at the Polytechnic University of the Philippines - San Juan Campus. 
            My passion lies in web development and UI/UX design, where I enjoy creating seamless and engaging digital experiences.
          </p>
          <p>
            This website serves as my personal online portfolio, a space where I document my growth, showcase my work, and reflect on my journey. 
            Here, you’ll find my academic and personal projects, writings, creative experiments, and a few multimedia pieces along the way.
          </p>
          <p>
            I made this site as close to my preference and personality as possible. Feel free to look around and get to know me better!
          </p>
        </div>
      </BlurFade>
    </Section>

    <!-- Education Section -->
    <Section id="education" title="Education">
      <div class="flex flex-col gap-8">
        {education.map((edu, idx) => (
          <BlurFade delay={BLUR_FADE_DELAY * (4 + idx)} client:load>
            <div class="flex items-center gap-x-3 justify-between group">
              <div class="flex items-center gap-x-3 flex-1 min-w-0">
                <div class="size-10 flex items-center justify-center border rounded-full shadow ring-2 ring-border bg-muted overflow-hidden">
                  <Icon name="lucide:graduation-cap" class="size-5" />
                </div>
                <div class="flex-1 min-w-0 flex flex-col gap-0.5">
                  <div class="font-semibold leading-none flex items-center gap-2">
                    {edu.school}
                  </div>
                  <div class="font-sans text-sm text-muted-foreground line-clamp-1">
                    {edu.degree}
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-1 text-xs tabular-nums text-muted-foreground text-right flex-none">
                <span>{edu.period}</span>
              </div>
            </div>
          </BlurFade>
        ))}
      </div>
    </Section>

    <!-- Skills Section -->
    <Section id="skills" title="Skills">
      <div class="flex flex-wrap gap-2">
        {skills.map((skill, idx) => (
          <BlurFade delay={BLUR_FADE_DELAY * (6 + idx)} client:load>
            <div class={cn(badgeVariants({ variant: 'outline' }), "rounded-xl h-8 px-4 flex items-center gap-2 border-border ring-2 ring-border/5")}>
              <span class="text-foreground text-sm font-medium">{skill}</span>
            </div>
          </BlurFade>
        ))}
      </div>
    </Section>

    <!-- Projects Section -->
    <Section id="projects" title="Projects">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="flex flex-col gap-4">
          {projects.filter((_, idx) => idx % 2 === 0).map((project, idx) => (
            <BlurFade delay={BLUR_FADE_DELAY * (10 + idx * 2)} client:load>
              <ProjectCard 
                title={project.data.title}
                description={project.data.description}
                tags={project.data.tags}
                image={project.data.image}
                link={project.data.link}
              />
            </BlurFade>
          ))}
        </div>
        <div class="flex flex-col gap-4">
          {projects.filter((_, idx) => idx % 2 !== 0).map((project, idx) => (
            <BlurFade delay={BLUR_FADE_DELAY * (11 + idx * 2)} client:load>
              <ProjectCard 
                title={project.data.title}
                description={project.data.description}
                tags={project.data.tags}
                image={project.data.image}
                link={project.data.link}
              />
            </BlurFade>
          ))}
        </div>
      </div>
    </Section>

    <!-- Contact Section -->
    <Section id="contact" title="Get in Touch">
      <BlurFade delay={BLUR_FADE_DELAY * 15} client:load>
        <p class="text-muted-foreground">
          If you have any message, suggestions, or inquiries, don’t hesitate to drop it in my 
          <a href={SOCIAL_LINKS.find(l => l.label === 'Inbox')?.href || '#'} class="text-foreground underline underline-offset-4 decoration-border hover:decoration-foreground transition-colors">inbox</a>.
        </p>
        <div class="flex gap-4 mt-2">
          {SOCIAL_LINKS.filter(l => l.label !== 'Inbox').map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors">
              <span class="text-sm">{link.label}</span>
            </a>
          ))}
        </div>
      </BlurFade>
    </Section>
  </div>
</Layout>
