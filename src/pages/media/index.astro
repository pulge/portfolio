---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Container from '@/components/Container.astro'
import PageHead from '@/components/PageHead.astro'
import PhotoCollection from '@/components/PhotoCollection.astro'
import BlurFade from '@/components/magicui/BlurFade'
import Section from '@/components/Section.astro'
import Layout from '@/layouts/Layout.astro'
import { getCollection } from 'astro:content'

const BLUR_FADE_DELAY = 0.04
const photoCollections = await getCollection('media')
// Sort collections by date (newest first)
const sortedPhotoCollections = photoCollections.sort((a, b) => {
  // Convert dates to timestamps or use 0 if date is invalid
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0
  return dateB - dateA
})
---

<Layout>
  <PageHead slot="head" title="media" />

  <div class="relative z-10 flex flex-col gap-14 py-12 pb-24 sm:py-24">
    <!-- Header Section -->
    <Section id="header">
      <BlurFade delay={BLUR_FADE_DELAY} client:load>
        <h1 class="text-3xl font-bold tracking-tighter sm:text-4xl lg:text-5xl mb-3">
          Media
        </h1>
      </BlurFade>
      <BlurFade delay={BLUR_FADE_DELAY * 2} client:load>
        <p class="text-muted-foreground md:text-lg lg:text-xl max-w-[600px]">
          Creative experiments, photography, and multimedia pieces.
        </p>
      </BlurFade>
    </Section>

    <!-- Gallery Section -->
    <Section id="gallery">
      {
        sortedPhotoCollections.length > 0 ? (
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="flex flex-col gap-4">
              {sortedPhotoCollections.filter((_, idx) => idx % 2 === 0).map((collection, idx) => (
                <BlurFade delay={BLUR_FADE_DELAY * (4 + idx * 2)} client:load>
                  <PhotoCollection collection={collection} />
                </BlurFade>
              ))}
            </div>
            <div class="flex flex-col gap-4">
              {sortedPhotoCollections.filter((_, idx) => idx % 2 !== 0).map((collection, idx) => (
                <BlurFade delay={BLUR_FADE_DELAY * (5 + idx * 2)} client:load>
                  <PhotoCollection collection={collection} />
                </BlurFade>
              ))}
            </div>
          </div>
        ) : (
          <BlurFade delay={BLUR_FADE_DELAY * 4} client:load>
            <p class="text-muted-foreground flex h-32 items-center justify-center border rounded-xl border-dashed">
              No photos found.
            </p>
          </BlurFade>
        )
      }
    </Section>
  </div>
</Layout>
