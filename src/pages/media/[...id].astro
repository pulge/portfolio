---
import BlurFade from '@/components/magicui/BlurFade'
import PageHead from '@/components/PageHead.astro'
import PhotoGallery from '@/components/PhotoGallery.astro'
import Section from '@/components/Section.astro'
import { badgeVariants } from '@/components/ui/badge'
import Layout from '@/layouts/Layout.astro'
import { getAlbumImages } from '@/lib/media-utils'
import { cn, slugify } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { type CollectionEntry, getCollection } from 'astro:content'

export async function getStaticPaths() {
  const photos = await getCollection('media')
  return photos.map((collection) => ({
    params: { id: collection.id },
    props: collection,
  }))
}

type Props = CollectionEntry<'media'>
const collection = Astro.props

const galleryImages = await getAlbumImages(collection.id)
const BLUR_FADE_DELAY = 0.04
---

<Layout>
  <PageHead slot="head" title={collection.data.title || collection.data.name} />
  
  <div class="relative z-10 flex flex-col gap-14 py-12 pb-24 sm:py-24">
    <Section id="media-header" title={collection.data.title || collection.data.name}>
      <div class="flex flex-col gap-4 mt-[-1rem]">
        <BlurFade delay={BLUR_FADE_DELAY} client:load>
          <div class="flex items-center justify-between gap-4 flex-wrap">
            <span class="text-sm text-muted-foreground tabular-nums">{collection.data.period}</span>
            <div class="flex flex-wrap gap-2">
              {collection.data.tags?.map((tag: string) => (
                <a href={`/tags/${slugify(tag)}`} class={cn(badgeVariants({ variant: 'outline' }), "rounded-xl bg-white/25 h-7 px-3 flex items-center gap-1.5 border-border ring-2 ring-border/5 text-xs lowercase")}>
                  <Icon name="lucide:hash" class="size-3 text-muted-foreground" />
                  {slugify(tag)}
                </a>
              ))}
            </div>
          </div>
        </BlurFade>

        {(collection.data.description || collection.data.remarks) && (
          <BlurFade delay={BLUR_FADE_DELAY * 2} client:load>
            <div class="prose max-w-full text-pretty font-sans leading-relaxed text-muted-foreground dark:prose-invert space-y-4">
              {collection.data.description && <p>{collection.data.description}</p>}
              {collection.data.remarks && <p class="text-sm italic opacity-80">{collection.data.remarks}</p>}
            </div>
          </BlurFade>
        )}
      </div>

      <div class="mt-12">
        <PhotoGallery
          name={collection.data.name}
          images={galleryImages}
          id={collection.id}
          delay={BLUR_FADE_DELAY * 3}
        />
      </div>
    </Section>
  </div>
</Layout>
