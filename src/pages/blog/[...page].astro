---
import BlogCard from '@/components/BlogCard.astro'
import PageHead from '@/components/PageHead.astro'
import PaginationComponent from '@/components/ui/pagination'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getAllBlogs, groupPostsByYear } from '@/lib/data-utils'
import type { PaginateFunction } from 'astro'
import BlurFade from '@/components/magicui/BlurFade'
import Section from '@/components/Section.astro'

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction
}) {
  const allPosts = await getAllBlogs()
  return paginate(allPosts, { pageSize: SITE.postsPerPage })
}

const { page } = Astro.props

const postsByYear = groupPostsByYear(page.data)
const years = Object.keys(postsByYear).sort((a, b) => parseInt(b) - parseInt(a))

const BLUR_FADE_DELAY = 0.04
---

<Layout>
  <PageHead slot="head" title="articles" />

  <div class="relative z-10 flex flex-col gap-14 py-12 pb-24 sm:py-24">
    <!-- Header Section -->
    <Section id="header">
      <BlurFade delay={BLUR_FADE_DELAY} client:load>
        <h1 class="text-3xl font-bold tracking-tighter sm:text-4xl lg:text-5xl mb-3">
          Articles
        </h1>
      </BlurFade>
      <BlurFade delay={BLUR_FADE_DELAY * 2} client:load>
        <p class="text-muted-foreground md:text-lg lg:text-xl max-w-[600px]">
          Thoughts, technical writing, and general reflections on software and design.
        </p>
      </BlurFade>
    </Section>

    <!-- Posts Section -->
    <div class="flex flex-col gap-y-12">
      {
        years.map((year, yearIdx) => (
          <Section id={year} title={year}>
            <div class="flex flex-col gap-4">
              {postsByYear[year].map((post, postIdx) => (
                <BlurFade 
                  delay={BLUR_FADE_DELAY * (4 + yearIdx + postIdx)} 
                  client:load
                >
                  <BlogCard entry={post} />
                </BlurFade>
              ))}
            </div>
          </Section>
        ))
      }
    </div>

    {
      years.length > 3 && (
        <BlurFade delay={BLUR_FADE_DELAY * 10} client:load>
          <PaginationComponent
            currentPage={page.currentPage}
            totalPages={page.lastPage}
            baseUrl="/blog/"
            client:load
          />
        </BlurFade>
      )
    }
  </div>
</Layout>
