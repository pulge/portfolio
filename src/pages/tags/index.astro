---
import BlurFade from '@/components/magicui/BlurFade'
import PageHead from '@/components/PageHead.astro'
import Section from '@/components/Section.astro'
import { badgeVariants } from '@/components/ui/badge'
import Layout from '@/layouts/Layout.astro'
import { getSortedTags } from '@/lib/data-utils'
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'

const sortedTags = await getSortedTags()
const BLUR_FADE_DELAY = 0.04
---

<Layout class="max-w-2xl">
  <PageHead slot="head" title="Tags" />
  <div class="relative z-10 flex flex-col gap-14 py-12 pb-24 sm:py-24">
    <Section id="tags" title="Tags">
      <div class="flex flex-wrap gap-2">
        {
          sortedTags.map(({ tag, count }, idx) => (
            <BlurFade delay={BLUR_FADE_DELAY * (2 + idx)} client:load>
              <a
                href={`/tags/${tag}`}
                class={cn(badgeVariants({ variant: 'outline' }), "rounded-xl bg-white/25 h-8 px-4 flex items-center gap-2 border-border ring-2 ring-border/5 lowercase")}
              >
                <Icon name="lucide:hash" class="size-3.5 text-muted-foreground" />
                <span class="text-foreground text-sm font-medium">{tag}</span>
                <span class="text-muted-foreground text-xs ml-1 font-mono">({count})</span>
              </a>
            </BlurFade>
          ))
        }
      </div>
    </Section>
  </div>
</Layout>
