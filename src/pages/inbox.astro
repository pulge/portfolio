---
import BlurFade from '@/components/magicui/BlurFade'
import PageHead from '@/components/PageHead.astro'
import Section from '@/components/Section.astro'
import { buttonVariants } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Label } from '@/components/ui/label'
import { Textarea } from '@/components/ui/textarea'
import Layout from '@/layouts/Layout.astro'
import { cn } from '@/lib/utils'

const BLUR_FADE_DELAY = 0.04
---

<Layout>
  <PageHead slot="head" title="inbox" />
  
  <div class="relative z-10 flex flex-col gap-14 py-12 pb-24 sm:py-24">
    <!-- Header Section -->
    <Section id="header">
      <BlurFade delay={BLUR_FADE_DELAY} client:load>
        <h1 class="text-3xl font-bold tracking-tighter sm:text-4xl lg:text-5xl mb-3">
          Inbox
        </h1>
      </BlurFade>
      <BlurFade delay={BLUR_FADE_DELAY * 2} client:load>
        <p class="text-muted-foreground md:text-lg lg:text-xl max-w-[600px]">
          Drop me a message, a job offer, or just say hi. Messages are received anonymously.
        </p>
      </BlurFade>
    </Section>

    <!-- Form Section -->
    <Section id="contact">
      <BlurFade delay={BLUR_FADE_DELAY * 4} client:load>
        <form id="contact-form" class="flex flex-col gap-6">
          <div class="flex flex-col gap-2">
            <Label className="text-[14px] font-medium">Name or Contact</Label>
            <Input 
              name="name" 
              className="bg-muted/15 border-[0.5px] border-border rounded-[12px] h-10 px-4 focus:border-foreground/20 transition-colors" 
              placeholder="(optional)" 
            />
          </div>

          <div class="flex flex-col gap-2">
            <Label className="text-[14px] font-medium">Message</Label>
            <Textarea
              className="bg-muted/15 border-[0.5px] border-border rounded-[12px] p-4 min-h-[200px] focus:border-foreground/20 transition-colors"
              name="message"
              placeholder="Tell me something I don't know..."
              required
            />
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <p class="text-[11px] text-muted-foreground leading-tight">
              Note: Your message will be sent securely and anonymously.
            </p>
            <button
              id="submit-btn"
              class={cn(
                buttonVariants({ variant: 'static', size: 'sm' }),
                "rounded-full px-6 h-10 bg-foreground text-background hover:bg-foreground/90 transition-colors"
              )}
              type="submit"
            >
              Send Message
            </button>
          </div>
        </form>
      </BlurFade>
    </Section>
  </div>

  <!-- Toast Notification -->
  <div
    id="toast"
    class="fixed top-4 right-4 z-50 translate-x-[400px] transform rounded-lg px-6 py-3 shadow-lg transition-transform duration-300"
  >
    <p id="toast-message" class="text-white"></p>
  </div>
</Layout>

<script src="@/script/contact-form.js"></script>
